# Erdpuls Collective Threshold Model - Environment Configuration
# Copy to /var/www/erdpuls-threshold/.env and update values

# Database (ubec_erdpuls database, erdpuls_threshold schema)
DATABASE_URL=postgresql://user:password@localhost:5432/ubec_erdpuls

# Security
SECRET_KEY=<generated-secret-key>

# Debug mode (set to false in production)
DEBUG=false

# Base URL for email links
BASE_URL=https://erdpuls.ubec.network

# Dashboard-created per-initiative folders (MUST be outside the git repo tree).
# Create it and make sure the app user (ubec) owns it:
#   mkdir -p /srv/ubec/erdpuls-data/initiatives
#   chown -R ubec:ubec /srv/ubec/erdpuls-data
INITIATIVES_DATA_DIR=/srv/ubec/erdpuls-data/initiatives

# SMTP settings for port 465 (SSL):
SMTP_HOST=mail.ubec.network
SMTP_PORT=465
SMTP_USER=erdpuls@ubec.network
SMTP_PASSWORD=<password>
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=erdpuls@ubec.network
SMTP_FROM_NAME=Erdpuls Müllrose

