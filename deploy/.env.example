# Erdpuls Collective Threshold Model - Environment Configuration
# Copy to /var/www/erdpuls-threshold/.env and update values

# Database (ubec_erdpuls database, erdpuls_threshold schema)
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/ubec_erdpuls

# Security
SECRET_KEY=CHANGE_THIS_generate_with_python3_-c_"import_secrets;print(secrets.token_hex(32))"

# Debug mode (set to false in production)
DEBUG=false
