[Unit]
Description=Erdpuls Collective Threshold Model
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/erdpuls-threshold
Environment="PATH=/var/www/erdpuls-threshold/venv/bin"
EnvironmentFile=/var/www/erdpuls-threshold/.env
ExecStart=/var/www/erdpuls-threshold/venv/bin/uvicorn \
    app.main:app \
    --host 127.0.0.1 \
    --port 8004 \
    --workers 2
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
